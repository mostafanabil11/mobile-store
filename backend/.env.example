# Server
PORT=4000
FRONTEND_URL=http://localhost:3000

# MongoDB — leave empty in development to use a local in-memory database (data kept in ./.mongo-data)
MONGODB_URI=

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# First admin account (created on first boot if no admin exists)
ADMIN_EMAIL=admin@store.local
ADMIN_PASSWORD=change-me-now
ADMIN_NAME="Store Admin"

# Insert demo products on first boot when the products collection is empty
SEED_DEMO=true

# Free Apple device catalog used to prefill specs and photos (demo data from GSMArena)
CATALOG_API_URL=https://phone-specs-api.vercel.app
