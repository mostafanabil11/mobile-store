{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name -> https://mobile-store.<your-subdomain>.workers.dev
  "name": "mobile-store",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "observability": { "enabled": true },
  // Runtime values read by server components (process.env.API_URL).
  // The same values must be present at build time too (rewrites + NEXT_PUBLIC_*), see package.json "deploy".
  "vars": {
    "API_URL": "https://mobile-store-api-t6s0.onrender.com",
    "NEXT_PUBLIC_SITE_URL": "https://mobile-store.mostafa-nabil-arafa01.workers.dev"
  }
}
